# ============================================================
# BIS Sahayak — Backend Environment Variables Example
# ============================================================
# Copy this file to backend/.env and fill in your actual values.
# NEVER commit .env to git.
# ============================================================

# --- Server ---
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
APP_ENV=development

# --- CORS ---
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Database (Phase 5+) ---
# DATABASE_URL=postgresql://user:password@localhost:5432/bis_sahayak

# --- Embedding (Phase 7) ---
# Lightweight local embedding — zero cost, zero external downloads, no API key.
# Dimension is 384.
EMBEDDING_MODEL=local-lightweight-v1
EMBEDDING_DIMENSION=384

# Batch size for embedding generation (reduce if you get memory errors)
EMBEDDING_BATCH_SIZE=32

# --- Retrieval (Phase 7) ---
# Number of chunks to return per query
RETRIEVAL_TOP_K=5
# Minimum cosine similarity [0.0-1.0] — results below this are ignored
RETRIEVAL_SIMILARITY_THRESHOLD=0.30

# --- LLM Provider (Phase 10) ---
# "gemini" = Google Gemini 3.7 Flash free tier runtime
# "stub"   = offline placeholder for testing without API keys
LLM_PROVIDER=gemini

# --- Gemini Configuration (Phase 10) ---
# Get your free Gemini API key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.7-flash


